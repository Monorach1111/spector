# Firebase config — copy to .env and fill from the Firebase console.
# No real keys are committed to this repo. Without these, Spector still
# runs end-to-end in clearly-labelled Demo Mode (local rule-based analyser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: App Check reCAPTCHA v3 site key (for production).
# Leave empty for local development — the App Check debug provider is used instead.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
# Optional: cloud fallback model name for Firebase AI Logic hybrid inference.
# Default (when empty): the SDK default cloud model.
VITE_FIREBASE_CLOUD_MODEL=gemini-2.5-flash
