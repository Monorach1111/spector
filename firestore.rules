rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Scan history (collection `scans`, see src/lib/history.ts).
    // Any signed-in user (anonymous auth) can read/write scan records;
    // each record carries its author's uid. History also falls back to
    // localStorage when Firestore is unavailable, so this is best-effort.
    match /scans/{docId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
